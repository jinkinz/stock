# ── AI Provider ──────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: anthropic | openai | gemini | openrouter | ollama | custom
# Leave blank to auto-detect based on which key is present.
AI_PROVIDER=anthropic

# Model override (leave blank to use each provider's default)
AI_MODEL=

# ── Anthropic Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key-here

# ── OpenRouter (access 100+ models with one key) ─────────────────────────────
# https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key-here

# ── Ollama (local, no key needed) ────────────────────────────────────────────
# Default: http://localhost:11434  — change if your Ollama runs elsewhere
OLLAMA_BASE_URL=http://localhost:11434

# ── Custom / Any OpenAI-compatible endpoint ───────────────────────────────────
CUSTOM_AI_BASE_URL=https://your-endpoint.example.com
CUSTOM_AI_API_KEY=your-key-here
CUSTOM_AI_MODEL=your-model-name

# ── Longbridge ────────────────────────────────────────────────────────────────
LONGBRIDGE_APP_KEY=your-app-key
LONGBRIDGE_APP_SECRET=your-app-secret
LONGBRIDGE_ACCESS_TOKEN=your-access-token
